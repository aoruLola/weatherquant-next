# WeatherQuant Next - environment configuration
#
# Copy to `.env` and edit. Every value below is the built-in default, so an
# empty file behaves identically to no file at all.
#
# Prefix: WQ_

# --- storage ---------------------------------------------------------------
# Database written by this system (never the legacy one).
WQ_DB_PATH=data/weatherquant.duckdb
# Previous project's database. Opened READ-ONLY by weatherquant.legacy only.
WQ_LEGACY_DB_PATH=../backend/data/weatherquant.duckdb
# Upstream raw payload archive, for replaying without network access.
WQ_RAW_DIR=data/raw

# --- market definition -----------------------------------------------------
# ICAO station the markets resolve on. NOT KNYC - see docs/open-source-review.md.
WQ_STATION=KLGA
# Civil date the market settles on.
WQ_MARKET_TIMEZONE=America/New_York

# --- forecasts -------------------------------------------------------------
WQ_ECMWF_MODEL_ID=ecmwf_ifs025
WQ_GFS_MODEL_ID=gfs
# Hours after a model run's initialisation before it may be used.
# This is a leakage control, not a tuning knob: too small and the system acts
# on information the market did not yet have.
WQ_MODEL_LAG_HOURS=6

# --- pricing ---------------------------------------------------------------
# Polymarket taker fee rate for the Weather category (maker = 0).
# Source: docs.polymarket.com/trading/fees
WQ_WEATHER_FEE_RATE=0.05
# Execution buffer as a fraction of fill notional.
WQ_EXECUTION_BUFFER_FRACTION=0.005

# --- http ------------------------------------------------------------------
WQ_HTTP_TIMEOUT_SECONDS=20
WQ_HTTP_RETRIES=4
