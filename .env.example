# WeatherQuant Next - environment configuration
#
# Copy to `.env` and edit. Every value below is the built-in default, so an
# empty file behaves identically to no file at all.
#
# Prefix: WQ_

# --- storage ---------------------------------------------------------------
# Database written by this system (never the legacy one).
WQ_DB_PATH=data/weatherquant.duckdb
# Previous project's database. Opened READ-ONLY by weatherquant.legacy only.
WQ_LEGACY_DB_PATH=../backend/data/weatherquant.duckdb
# Upstream raw payload archive, for replaying without network access.
WQ_RAW_DIR=data/raw

# Research runs in its OWN database. The collector's schema and single-instance
# lock must never be touched by a research backfill.
WQ_RESEARCH_DB_PATH=data/research/weather-research.duckdb
WQ_RESEARCH_RAW_DIR=data/research/raw

# --- market definition -----------------------------------------------------
# ICAO station the markets resolve on. NOT KNYC - see docs/open-source-review.md.
WQ_STATION=KLGA
# Civil date the market settles on.
WQ_MARKET_TIMEZONE=America/New_York

# --- forecasts -------------------------------------------------------------
WQ_ECMWF_MODEL_ID=ecmwf_ifs025
WQ_GFS_MODEL_ID=gfs_seamless  # bare `gfs` is rejected by the API (400)
# Hours after a model run's initialisation before it may be used.
# This is a leakage control, not a tuning knob: too small and the system acts
# on information the market did not yet have.
WQ_MODEL_LAG_HOURS=6

# --- pricing ---------------------------------------------------------------
# Polymarket taker fee rate for the Weather category (maker = 0).
# Source: docs.polymarket.com/trading/fees
WQ_WEATHER_FEE_RATE=0.05
# Execution buffer as a fraction of fill notional.
WQ_EXECUTION_BUFFER_FRACTION=0.005

# --- http ------------------------------------------------------------------
WQ_HTTP_TIMEOUT_SECONDS=20
WQ_HTTP_RETRIES=4

# --- shadow engine (P2-0) --------------------------------------------------
# The shadow reads the collector's archive READ-ONLY and writes its own file.
# On the NAS this is the read-only bind mount of the collector's data dir:
#   WQ_COLLECTOR_RAW_DIR=/collector-raw
WQ_SHADOW_DB_PATH=data/shadow/shadow.duckdb
WQ_SHADOW_HEALTH_DIR=data/shadow/health
WQ_SHADOW_MODELS_DIR=models
# Risk gates. A versioned JSON file, not an environment variable, because a
# threshold widened on the box that also produces the results cannot be
# audited afterwards. Editing it means bumping its `version`.
WQ_SHADOW_THRESHOLDS_PATH=configs/shadow-thresholds.json
WQ_COLLECTOR_RAW_DIR=data/raw

# Which model decides ACCEPT/REJECT, and which produce prediction records.
WQ_SHADOW_PRIMARY_MODEL=calibrated
WQ_SHADOW_MODEL_NAMES=ecmwf_raw,gfs_raw,fusion,calibrated

# Cadence. The tick is the loop period; forecasts are fetched far less often
# so a burst of archive lines cannot become a burst of upstream calls.
WQ_SHADOW_TICK_SECONDS=5
WQ_SHADOW_FORECAST_REFRESH_SECONDS=600
WQ_SHADOW_METRICS_SECONDS=300
# No archive line for this long -> COLLECTOR_DISCONNECTED plus a data-quality
# event. 15 min tolerates the collector's own 5s flush plus a restart.
WQ_SHADOW_COLLECTOR_SILENCE_SECONDS=900
WQ_SHADOW_BACKOFF_MAX_SECONDS=300
WQ_SHADOW_MAX_NEW_RUNS_PER_CYCLE=2
WQ_SHADOW_RUN_LOOKBACK_HOURS=72

# LIVE vs REPLAY. `auto` (default) decides once at startup: an archive being
# written now is LIVE (silence is COLLECTOR_DISCONNECTED); an archive older
# than the silence window is history (REPLAY), whose decisions are stamped with
# the archive's own instant and never counted as live signals.
#   WQ_SHADOW_MODE=auto | live | replay
WQ_SHADOW_MODE=auto
