# syntax=docker/dockerfile:1.7
#
# WeatherQuant Next paper engine image. Kept separate from the collector and
# Shadow Dockerfiles so a Paper release cannot change either image.
#
# The versioned risk rules and dated fallback fee schedule are baked into the
# image. /shadow-decisions and /collector-raw are read-only mount points;
# /data is Paper's own state.

ARG PYTHON_VERSION=3.12

# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.13.0 AS uv

# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS builder

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev --no-editable \
    && /app/.venv/bin/python -c "import weatherquant; print('weatherquant', weatherquant.__version__)"

# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS runtime

RUN groupadd --gid 1000 wq \
    && useradd --uid 1000 --gid wq --no-create-home --home-dir /app --shell /usr/sbin/nologin wq

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC \
    WQ_PAPER_DB_PATH=/data/paper/paper.duckdb \
    WQ_PAPER_HEALTH_DIR=/data/health \
    WQ_PAPER_EVENTS_DIR=/shadow-decisions \
    WQ_PAPER_RAW_DIR=/collector-raw \
    WQ_PAPER_RISK_RULES_PATH=/app/configs/paper-risk.json \
    WQ_PAPER_FEE_SCHEDULE_PATH=/app/configs/fee-schedule.json \
    WQ_PAPER_API_HOST=0.0.0.0 \
    WQ_PAPER_API_PORT=8790

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --chown=wq:wq configs/paper-risk.json configs/fee-schedule.json ./configs/
COPY --chown=wq:wq docker/healthcheck_paper.py /usr/local/bin/healthcheck.py

RUN mkdir -p /data /shadow-decisions /collector-raw \
    && chown wq:wq /data /shadow-decisions /collector-raw

USER wq
VOLUME ["/data"]
EXPOSE 8790

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "/usr/local/bin/healthcheck.py"]

# PID 1 is the Paper process so Docker's stop signal reaches it directly.
ENTRYPOINT ["weatherquant-paper"]
CMD ["serve"]
