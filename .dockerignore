# Build context hygiene: everything below makes the image larger or leaks
# local state into it. The database must never be baked in.
.git
.github
.venv
.pytest_cache
.pytest_tmp
.ruff_cache
__pycache__
*.py[cod]
*.egg-info
.coverage
htmlcov
docs
research
tests
scripts
docker/compose.*.yaml
data
*.duckdb
*.duckdb.wal
*.parquet
.env
.env.local
.audit-out

# Frontend build inputs/outputs: the dashboard image rebuilds these in its own
# node stage, and shipping a host node_modules/ into the context would dwarf
# everything else.
node_modules
dashboard/frontend/dist
dashboard/frontend/test-results
dashboard/frontend/playwright-report
dashboard/screenshots
dashboard/fixtures/data
