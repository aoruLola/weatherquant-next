.github
.venv
.pytest_cache
.pytest_tmp
.ruff_cache
__pycache__
*.py[cod]
*.egg-info
.coverage
htmlcov
docs
research
tests
scripts
docker/compose.*.yaml
data
*.duckdb
*.duckdb.wal
*.parquet
.env
.env.local
.audit-out
