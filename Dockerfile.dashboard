# WeatherQuant Dashboard - single-container frontend + API.
#
# Three stages: the frontend is built by Node, the API by uv, and the runtime
# gets neither toolchain - just the built assets and a venv. The container:
#
#   * runs as uid 1000 (matches the NAS data directories),
#   * serves only GET over one port (8787),
#   * mounts data READ-ONLY in the compose file and never opens a .duckdb,
#   * has no Docker socket, no CLI, no credentials - it is a viewer.
#
# The `dashboard` dependency group is the only reason FastAPI exists here; the
# collector and shadow images (`uv sync --no-dev`) never install it.
FROM node:22-alpine AS frontend
WORKDIR /build
# Manifests first: source edits must not invalidate the npm layer.
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json ./
RUN npm ci
COPY dashboard/frontend/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.13.0 AS uv

FROM python:3.12-slim AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
# Dependencies first, project second: a code change must not re-resolve the lock.
RUN uv sync --frozen --no-dev --group dashboard --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev --group dashboard --no-editable

FROM python:3.12-slim AS runtime
RUN groupadd --gid 1000 wq \
    && useradd --uid 1000 --gid wq --no-create-home --home-dir /app --shell /usr/sbin/nologin wq
WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Built frontend (hashed assets, index.html) served by the API process itself.
COPY --from=frontend /build/dist /app/static
ENV WQ_STATIC_DIR=/app/static \
    WQ_HOST=0.0.0.0 \
    WQ_PORT=8787

# The probe: a plain HTTP GET, no imports from the app, no data access.
COPY docker/healthcheck_dashboard.py /usr/local/bin/healthcheck.py

USER wq
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD ["python", "/usr/local/bin/healthcheck.py"]

# uvicorn installs its own SIGTERM handling; the process is a plain reader, so
# a fast stop needs no drain time beyond letting the current request finish.
STOPSIGNAL SIGTERM
CMD ["weatherquant-dashboard"]
